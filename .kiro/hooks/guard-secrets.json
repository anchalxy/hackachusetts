{
  "version": "v1",
  "hooks": [
    {
      "name": "Guard dotenv secrets",
      "trigger": "PreToolUse",
      "description": "Blocks agent tool calls that read, write, move, delete, or git-stage .env / .env.local (allows .env.example).",
      "matcher": "^(read_file|read_code|fs_write|fs_append|str_replace|delete_file|smart_relocate|grep_search|file_search|execute_bash|control_bash_process)$",
      "action": {
        "type": "command",
        "command": "node .kiro/hook-scripts/guard-secrets.mjs",
        "timeout": 10
      }
    }
  ]
}